{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "CLI: control the bundled replay",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_cli.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: control my CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_cli.py",
      "args": ["--csv", "${input:csvPath}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    { "id": "csvPath", "type": "promptString", "description": "CSV file to control", "default": "data/my_room.csv" }
  ]
}
